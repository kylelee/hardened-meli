    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "send_email"
      },
      "description": "Send a message through the account's configured transport. Requires the `send` mutation, recipients must match [mcp] send_recipient_allowlist, and a rate limit applies. The From address is always the account identity. There is deliberately no delete tool.",
