        "additionalProperties": false,
        "properties": {
          "account": {
            "description": "Account name",
            "type": "string"
          },
          "bcc": {
            "description": "Bcc addresses",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "body": {
            "description": "Plain text body",
            "type": "string"
          },
          "cc": {
            "description": "Cc addresses",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "in_reply_to": {
            "description": "Message-ID this mail replies to (gets angle brackets)",
            "type": "string"
          },
          "references": {
            "description": "References chain Message-IDs",
            "items": {
              "type": "string"
            },
            "type": "array"
